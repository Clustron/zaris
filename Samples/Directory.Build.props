<Project>
  <PropertyGroup>
    <!-- Version of the Clustron Zaris packages the samples consume from the shared local
         repo. The sanity harness overrides this (-p:ClustronZarisVersion=...) so the samples
         always build against the freshly packed build; the default keeps them buildable
         standalone. -->
    <ClustronZarisVersion Condition="'$(ClustronZarisVersion)' == ''">1.1.0</ClustronZarisVersion>
  </PropertyGroup>
</Project>
