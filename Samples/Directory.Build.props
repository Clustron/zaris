<Project>
  <PropertyGroup>
    <!-- Version of the Clustron Zaris packages the samples consume. Defaults to the FLOATING
         "latest 2.x" (NuGet resolves 2.* to the highest published 2.x on nuget.org), so the
         samples automatically track every minor/patch release with NO per-release edit. Only the
         next MAJOR bump (3.0.0) needs a one-time change here to 3.*. The sanity harness still
         overrides this (-p:ClustronZarisVersion=<exact>) to build against the freshly packed build. -->
    <ClustronZarisVersion Condition="'$(ClustronZarisVersion)' == ''">2.*</ClustronZarisVersion>
  </PropertyGroup>
</Project>
