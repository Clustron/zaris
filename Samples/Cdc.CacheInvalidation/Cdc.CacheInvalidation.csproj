<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CDC "cache invalidation" sample. Same project shape as the other samples (host builder + Shared +
    appsettings.json), with ONE difference: the change feed requires the server op-log and the
    remote client, so appsettings.json defaults to a Remote connection string instead of InProc.
    The change feed is a Zaris 2.1.0+ feature (ClustronZarisVersion resolves to 2.* via
    Directory.Build.props).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
