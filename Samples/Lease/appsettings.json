{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft": "Warning",
            "System": "Warning",
            "System.Net.Http.HttpClient": "Warning",
            "Clustron.Core": "Warning",
            "Clustron.Dictus": "Warning"
        }
