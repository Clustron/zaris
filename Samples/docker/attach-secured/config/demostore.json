{
  "$schema": "https://schemas.clustron.io/zaris/v1/store.schema.json",
  "//": "Shared config for the 4 demostore node containers. Each container sets CLUSTRON_NODE_ID to the node it IS; peers are addressed by docker-compose service name (Docker DNS). clusterId is the store name the console/CLI use and the applicationId the nodes publish counters under.",
  "clusterId": "demostore",
  "//partitions": "1 partition per node with RF 2 on 4 instances = 2 partitions: the mapless-mint partitioner mints one partition per preferredPrimary node (n0, n2) and places each partition's replica on a remaining node (n1, n3). So every node holds exactly one partition (2 primary + 2 replica) — one-per-node, fully RF 2.",
  "nodes": [
    {
      "id": "demostore-n0",
      "host": "demostore-n0",
      "clusterPort": 7811,
      "clientPort": 7861,
      "preferredPrimary": true
    },
    {
      "id": "demostore-n1",
      "host": "demostore-n1",
      "clusterPort": 7811,
      "clientPort": 7861
    },
    {
      "id": "demostore-n2",
      "host": "demostore-n2",
      "clusterPort": 7811,
      "clientPort": 7861,
      "preferredPrimary": true
    },
    {
      "id": "demostore-n3",
      "host": "demostore-n3",
      "clusterPort": 7811,
      "clientPort": 7861
    }
  ],
  "replication": {
    "factor": 2,
    "mode": "Async",
    "quorum": "All",
    "syncAckTimeoutSeconds": 5
  },
  "//pushMetrics": "Bake the manager's counter-publishing URL so each orchestrator-run node publishes its counters to the attached manager on boot (attach nodes get no injected target the way supervisor forks do).",
  "pushMetrics": {
    "pushTargetUrl": "http://demostore-manager:7801",
    "rollingWindowSeconds": 120,
    "timeoutMilliseconds": 60000
  },
