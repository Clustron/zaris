<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Shared local package repo produced by the top-level build.ps1 -->
    <add key="LocalRepo" value="..\..\localRepo" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Clustron packages resolve from a local build feed when present (used by the release sanity
       harness, which packs freshly-built NuGets into ..\..\localRepo) and otherwise from nuget.org,
       so a public clone of this repo restores the released packages without any local setup. -->
  <packageSourceMapping>
    <packageSource key="LocalRepo">
      <package pattern="Clustron.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- Same pattern length as LocalRepo's Clustron.*, so Clustron packages resolve from
           whichever source has them: LocalRepo for the release sanity, nuget.org for public clones. -->
      <package pattern="Clustron.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
