<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Shared local package repo produced by the top-level build.ps1 -->
    <add key="LocalRepo" value="..\..\localRepo" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- In-house packages come from the local repo only; nuget.org may hold stale
       builds published under the same version numbers. -->
  <packageSourceMapping>
    <packageSource key="LocalRepo">
      <package pattern="Clustron.*" />
      <package pattern="MetricsFlow.*" />
      <package pattern="KeyFence.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
