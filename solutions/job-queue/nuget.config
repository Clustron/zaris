<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The Clustron.Zaris.* 2.0.1 client packages (and everything else) are resolved
    from nuget.org. No local feed is required to build this solution.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
